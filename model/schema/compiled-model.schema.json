{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OP-TED/ESPD-EDM/model/schema/compiled-model.schema.json",
  "title": "ESPD compiled-model envelope",
  "description": "model/compiled-model.json. The manifest of the published ESPD model: which ESPD/UBL version it is, exactly which inputs it was built from, and an inventory of the criteria and value types with the files that belong to each. Generated by espd-tools/model-compiler; never hand-edited. Deterministic: the same inputs always yield the same bytes.",
  "type": "object",
  "required": ["envelopeVersion", "espdVersion", "ublVersion", "provenance", "counts", "criteria", "valueTypes", "parts", "registries"],
  "properties": {
    "$comment": { "type": "string" },
    "envelopeVersion": { "const": 1, "description": "Version of this envelope format." },
    "espdVersion": { "type": "string", "minLength": 1, "description": "ESPD-EDM version, read from codelists.json." },
    "ublVersion": { "type": "string", "minLength": 1, "description": "UBL version, read from codelists.json." },
    "provenance": {
      "type": "object",
      "required": ["generator", "structure", "enrichment", "valueTypeSource"],
      "properties": {
        "generator": {
          "type": "object",
          "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
          "additionalProperties": false
        },
        "structure": {
          "type": "object",
          "description": "The EA export the structure came from.",
          "required": ["file", "sha256"],
          "properties": {
            "file": { "type": "string", "description": "Logical location of the export inside ESPD-EDM." },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the file with line endings normalised to LF." }
          },
          "additionalProperties": false
        },
        "enrichment": {
          "type": "object",
          "description": "The enrichment sources (registries and criterion files) the model was built from.",
          "required": ["sha256", "files"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 over the sorted relative paths and LF-normalised contents of the enrichment files." },
            "files": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "valueTypeSource": {
          "type": "object",
          "description": "The code list that is authoritative for which value types exist.",
          "required": ["shortName", "version"],
          "properties": { "shortName": { "type": "string" }, "version": { "type": "string" } },
          "additionalProperties": false
        },
        "sourceRef": { "type": "string", "description": "Optional free-text reference to the source commits, supplied by the build." }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["criteria", "valueTypes", "instanceDataFiles", "xmlMappingFiles", "compiledFiles", "partSections"],
      "properties": {
        "criteria": { "type": "integer", "minimum": 0 },
        "valueTypes": { "type": "integer", "minimum": 0 },
        "instanceDataFiles": { "type": "integer", "minimum": 0 },
        "xmlMappingFiles": { "type": "integer", "minimum": 0 },
        "compiledFiles": { "type": "integer", "minimum": 0 },
        "partSections": { "type": "integer", "minimum": 0, "description": "Sections of the administrative parts; each has four files." }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "description": "Modeled criteria, ordered by part then key.",
      "items": {
        "type": "object",
        "required": ["key", "id", "code", "part", "leaves", "repeatableBindings", "valueTypes", "files"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "description": "Output identity; the file stem of every file of this criterion." },
          "id": { "type": "string", "minLength": 1, "description": "Stable semantic id of the criterion." },
          "code": { "type": "string", "minLength": 1, "description": "EA criterion code as in espd-edm.json." },
          "tag": { "type": "string", "description": "EA tag (e.g. C65_OT), present for the Part II/V criteria keyed 'ot-<id>'." },
          "part": { "enum": ["I", "II", "III", "IV", "V", "VI"] },
          "leaves": { "type": "integer", "minimum": 0, "description": "Number of value leaves." },
          "repeatableBindings": { "type": "integer", "minimum": 0, "description": "Number of repeatable (0..n) bindings." },
          "valueTypes": { "type": "array", "items": { "type": "string" }, "description": "Distinct value types used, sorted." },
          "files": {
            "type": "object",
            "description": "Paths relative to the model folder; mappings are null when the criterion has a shape the mapping generators do not support yet.",
            "required": ["instanceSchema", "instanceExample", "compiled", "requestMapping", "responseMapping"],
            "properties": {
              "instanceSchema": { "type": "string" },
              "instanceExample": { "type": "string" },
              "compiled": { "type": "string" },
              "requestMapping": { "type": ["string", "null"] },
              "responseMapping": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "valueTypes": {
      "type": "array",
      "description": "Registered value types, sorted by name.",
      "items": {
        "type": "object",
        "required": ["name", "request", "response", "usedBy"],
        "properties": {
          "name": { "type": "string" },
          "request": { "type": "boolean", "description": "Has a buyer-side (Request) UBL binding." },
          "response": { "type": "boolean", "description": "Has an economic-operator-side (Response) UBL binding." },
          "usedBy": { "type": "integer", "minimum": 0, "description": "Number of modeled criteria using the type." }
        },
        "additionalProperties": false
      }
    },
    "parts": {
      "type": "array",
      "description": "The administrative parts (I, II, VI): the data and the form every consumer fills in that are not criteria. Authored in the enrichment and published verbatim; ordered by part.",
      "items": {
        "type": "object",
        "required": ["part", "manifest", "sections"],
        "properties": {
          "part": { "enum": ["I", "II", "VI"] },
          "manifest": { "type": "string", "description": "parts/<part>/index.json: the part header and the order of its sections." },
          "sections": {
            "type": "array",
            "minItems": 1,
            "description": "In manifest order. Paths are relative to the model folder.",
            "items": {
              "type": "object",
              "required": ["id", "schema", "example", "mapping", "form"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z]$" },
                "schema": { "type": "string", "description": "Instance-data JSON Schema of the section." },
                "example": { "type": "string", "description": "A valid example instance." },
                "mapping": { "type": "string", "description": "Instance data to UBL mapping." },
                "form": { "type": "string", "description": "The fields to fill in: input types, labels, code lists." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "registries": {
      "type": "array",
      "description": "Published registry files, relative to the model folder.",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
